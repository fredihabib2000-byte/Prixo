# Copy this file to .env and fill it in. NEVER commit .env to git.

# Supabase -> Project Settings -> Database -> Connection string.
# Use the "Session pooler" string (port 5432). Replace [YOUR-PASSWORD] with your database password.
# If your password has special characters (@ : / # ?), URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Long random strings:  openssl rand -hex 32
SESSION_SECRET=
PW_SALT=

# Owner console login, used ONLY the first time the app starts on an empty database.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-now
